# Copy to .env for local development. Placeholders only: never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Docker Postgres:
DATABASE_URL=postgresql+asyncpg://jobify:jobify@localhost:5432/jobify
# Hosted (Neon): paste the connection string exactly as the dashboard shows it. The app converts it.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-development-only-not-for-production

# AI (OpenRouter). The key lives only here, on the server. Leave empty to disable AI calls.
OPENROUTER_API_KEY=
# Model per tier. Defaults are free models; change without touching code.
# AI_MODEL_FAST=google/gemma-4-26b-a4b-it:free
# AI_MODEL_BALANCED=qwen/qwen3.8-27b:free
# AI_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b:free
# Per-user daily cap on model calls (free OpenRouter models allow few requests per day overall).
AI_DAILY_REQUEST_LIMIT_PER_USER=30
AGENT_MAX_STEPS=8

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# JSON list, e.g. ["http://localhost:8081"]
CORS_ORIGINS=[]
